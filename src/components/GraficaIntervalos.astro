---
/**
 * Puntos con intervalo, una fila por categoría, para cualquier magnitud (no solo %).
 * Opcional: una franja por fila (p. ej., el rango de un placebo) y una línea de referencia.
 * D3 corre al compilar; la página recibe un SVG fijo que se lee sin JavaScript (regla 7).
 * Colores solo como variables de tokens.css.
 */
import { scaleLinear } from 'd3-scale';
import { formatLocale } from 'd3-format';

interface Fila {
  etiqueta: string;
  detalle?: string;          // segunda línea, en gris
  valor: number;
  lo: number;
  hi: number;
  franja?: [number, number]; // rango de comparación (gris claro)
  marca?: number;            // raya vertical dentro de la franja (p. ej., mediana del placebo)
  foco?: boolean;
}
interface Props {
  filas: Fila[];
  dominio: [number, number];
  referencia?: { valor: number; texto: string };
  formato?: string;          // d3-format, p. ej. '.2f'
  sufijo?: string;
  leyenda?: { punto: string; franja?: string };
  etiquetaAria: string;
  pie: string;
}
const { filas, dominio, referencia, formato = '.2f', sufijo = '', leyenda, etiquetaAria, pie } = Astro.props;
const local = formatLocale({ decimal: ',', thousands: '.', grouping: [3], currency: ['Q', ''] });
const f = (v: number) => local.format(formato)(v) + sufijo;

const W = 600, L = 215, R = 70, ARRIBA = leyenda ? 36 : 10, altoFila = 46;
const abajo = ARRIBA + altoFila * filas.length;
const alto = abajo + (referencia ? 48 : 28);
const x = scaleLinear().domain(dominio).range([L, W - R]).clamp(true);
const ticks = x.ticks(5);
---
<figure class="gi">
  <svg viewBox={`0 0 ${W} ${alto}`} role="img" aria-label={etiquetaAria}>
    {leyenda && (
      <g class="leyenda">
        <circle cx="6" cy="12" r="5.5" style="fill:var(--dato-nucleo)" />
        <text x="18" y="17">{leyenda.punto}</text>
        {leyenda.franja && <rect x="250" y="5" width="22" height="14" style="fill:var(--dato-banda)" />}
        {leyenda.franja && <line x1="261" x2="261" y1="5" y2="19" style="stroke:var(--fg-suave);stroke-width:2" />}
        {leyenda.franja && <text x="280" y="17">{leyenda.franja}</text>}
      </g>
    )}
    {ticks.map((t) => (
      <g>
        <line x1={x(t)} x2={x(t)} y1={ARRIBA} y2={abajo} class="rejilla" />
        <text x={x(t)} y={abajo + 18} text-anchor="middle" class="suave chico">{f(t)}</text>
      </g>
    ))}
    {referencia && (
      <g>
        <line x1={x(referencia.valor)} x2={x(referencia.valor)} y1={ARRIBA} y2={abajo} class="referencia" />
        <text x={x(referencia.valor)} y={abajo + 38} text-anchor="middle" class="suave chico">{referencia.texto}</text>
      </g>
    )}
    {filas.map((r, i) => {
      const y = ARRIBA + altoFila * i + altoFila / 2;
      const c = r.foco ? 'var(--dato-nucleo)' : 'var(--fg-suave)';
      const tip = `${r.etiqueta}: ${f(r.valor)} (intervalo ${f(r.lo)} a ${f(r.hi)})` +
        (r.franja ? `; comparación ${f(r.franja[0])} a ${f(r.franja[1])}` : '');
      return (
        <g>
          <text x="0" y={r.detalle ? y - 3 : y + 5} class={r.foco ? 'fuerte' : ''}>{r.etiqueta}</text>
          {r.detalle && <text x="0" y={y + 13} class="suave mini">{r.detalle}</text>}
          {r.franja && <rect x={x(r.franja[0])} y={y - 11} width={Math.max(2, x(r.franja[1]) - x(r.franja[0]))} height="22" style="fill:var(--dato-banda)" />}
          {r.marca !== undefined && <line x1={x(r.marca)} x2={x(r.marca)} y1={y - 11} y2={y + 11} style="stroke:var(--fg-suave);stroke-width:2" />}
          <g>
            <title>{tip}</title>
            <line x1={x(r.lo)} x2={x(r.hi)} y1={y} y2={y} style={`stroke:${c};stroke-width:2.5`} />
            <circle cx={x(r.valor)} cy={y} r="6" style={`fill:${c}`} />
          </g>
          <text x={W - R + 10} y={y + 5} class={`valor ${r.foco ? 'fuerte' : ''}`}>{f(r.valor)}</text>
        </g>
      );
    })}
  </svg>
  <figcaption>{pie}</figcaption>
</figure>

<style>
  .gi { margin: var(--e4) 0; }
  svg { width: 100%; height: auto; font-family: var(--sans); font-size: 15px; overflow: visible; }
  text { fill: var(--fg); }
  .suave { fill: var(--fg-suave); }
  .chico { font-size: 13px; }
  .mini { font-size: 12px; }
  .fuerte { font-weight: 700; }
  .leyenda text { fill: var(--fg-suave); font-size: 13px; }
  .rejilla { stroke: var(--linea); }
  .referencia { stroke: var(--fg-suave); stroke-dasharray: 4 4; }
  figcaption { font-size: 0.9rem; color: var(--fg-suave); margin-top: var(--e2); }
</style>
