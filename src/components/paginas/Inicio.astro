---
import Base from '../../layouts/Base.astro';
import Trayectoria from '../Trayectoria.astro';
import TarjetaPieza from '../TarjetaPieza.astro';
import perfil from '../../data/perfil.json';
import proyectos from '../../data/proyectos.json';
import cvEs from '../../data/cv.es.json';
import cvEn from '../../data/cv.en.json';
import { type Idioma, ruta, t } from '../../i18n';

interface Props { idioma: Idioma; }
const { idioma } = Astro.props;
const ui = t(idioma);
const cv = idioma === 'es' ? cvEs : cvEn;
const destacados = proyectos.filter((p) => p.destacado);
---
<Base
  idioma={idioma}
  titulo={`${perfil.nombre} — ${idioma === 'es' ? 'Periodismo, investigación y producto' : 'Journalism, research and product'}`}
  descripcion={perfil.titular[idioma]}
>
  <section class="portada banda">
    <div class="envoltura">
      <p class="micro portada__kicker">{perfil.nombreCompleto}</p>
      <h1 class="portada__titular">{perfil.titular[idioma]}</h1>
      <p class="grande lectura portada__entradilla">{perfil.entradilla[idioma]}</p>
      <p class="portada__acciones">
        <a class="boton boton--lleno" href={ruta('cv', idioma)}>{ui.verCv}</a>
        <a class="boton" href={ruta('trabajo', idioma)}>{ui.verTrabajo}</a>
      </p>
    </div>
  </section>

  <Trayectoria idioma={idioma} experiencia={cv.experiencia} educacion={cv.educacion} />

  <section class="banda" aria-labelledby="titulo-seleccion">
    <div class="envoltura">
      <div class="encabezado-seccion">
        <span class="micro">{ui.seleccion}</span>
        <h2 id="titulo-seleccion">{ui.seleccionPie}</h2>
      </div>

      <div class="mosaico">
        {destacados.map((p, i) => (
          <TarjetaPieza idioma={idioma} pieza={p} ancha={i === 0} />
        ))}
      </div>

      <p class="seleccion__mas">
        <a class="boton" href={ruta('trabajo', idioma)}>{ui.verTrabajo}</a>
      </p>
    </div>
  </section>
</Base>

<style>
  .portada { padding-block: clamp(var(--e5), 11vh, 8rem) var(--e5); }
  .portada__kicker { color: var(--acento-texto); margin: 0 0 var(--e3); }
  .portada__titular {
    font-size: var(--h0);
    font-weight: 700;
    line-height: 1.0;
    letter-spacing: -0.035em;
    max-width: 19ch;
    margin: 0 0 var(--e4);
  }
  .portada__entradilla { color: var(--gris); margin-bottom: var(--e4); }
  .portada__acciones { display: flex; flex-wrap: wrap; gap: var(--e2); margin: 0; }
  .seleccion__mas { margin: var(--e4) 0 0; }
</style>
