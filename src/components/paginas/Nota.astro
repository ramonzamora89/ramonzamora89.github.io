---
import Base from '../../layouts/Base.astro';
import { render } from 'astro:content';
import { type Idioma, ruta, t } from '../../i18n';

interface Props { idioma: Idioma; nota: any; }
const { idioma, nota } = Astro.props;
const ui = t(idioma);
const { Content } = await render(nota);

const formato = new Intl.DateTimeFormat(idioma === 'es' ? 'es-GT' : 'en-US', {
  year: 'numeric', month: 'long', day: 'numeric',
  // Las fechas del frontmatter son medianoche UTC: sin esto, en Guatemala
  // (UTC-6) salen un día antes.
  timeZone: 'UTC',
});
---
<Base
  idioma={idioma}
  titulo={`${nota.data.titulo} — Ramón Zamora`}
  descripcion={nota.data.resumen ?? nota.data.titulo}
  alterna={`${ruta('notas', idioma === 'en' ? 'es' : 'en')}${nota.data.par ? `${nota.data.par}/` : ''}`}
>
  <article class="banda">
    <div class="envoltura">
      <p class="micro"><a href={ruta('notas', idioma)}>{ui.navNotas}</a></p>
      <header class="lectura nota__cabeza">
        <p class="micro tenue"><time datetime={nota.data.fecha.toISOString().slice(0, 10)}>{formato.format(nota.data.fecha)}</time></p>
        <h1>{nota.data.titulo}</h1>
      </header>
      <div class="lectura prosa"><Content /></div>
    </div>
  </article>
</Base>

<style>
  .nota__cabeza { margin: var(--e3) 0 var(--e5); }
  .nota__cabeza h1 { font-size: var(--h1); font-weight: 700; letter-spacing: -0.03em; }
  .prosa :global(h2) { font-size: var(--h3); margin-top: var(--e5); }
  .prosa :global(h3) { font-size: 1.15rem; margin-top: var(--e4); }
  .prosa :global(img) { border-radius: var(--radio); margin: var(--e4) 0; }
  .prosa :global(blockquote) {
    margin: var(--e4) 0; padding-left: var(--e3);
    border-left: 3px solid var(--acento);
    font-family: var(--serif); font-size: var(--texto-grande);
  }
  .prosa :global(pre) {
    background: var(--crema-calido); padding: var(--e3);
    border-radius: var(--radio); overflow-x: auto; font-size: 0.9rem;
  }
  .prosa :global(.crono) { list-style: none; padding: 0; margin: var(--e4) 0; border-left: 2px solid var(--acento); }
  .prosa :global(.crono li) { padding: 0 0 var(--e3) var(--e3); position: relative; }
  .prosa :global(.crono time) { display: block; font-family: var(--sans); font-size: var(--micro); letter-spacing: var(--tracking-micro); text-transform: uppercase; color: var(--fg-suave); }
  .prosa :global(.tabla) { overflow-x: auto; margin: var(--e4) 0; }
  .prosa :global(table) { border-collapse: collapse; width: 100%; font-family: var(--sans); font-size: 0.9rem; }
  .prosa :global(caption) { text-align: left; color: var(--fg-suave); font-size: 0.9rem; margin-bottom: var(--e2); }
  .prosa :global(th) { text-align: left; font-weight: 700; border-bottom: 2px solid var(--fg); padding: var(--e1) var(--e2); vertical-align: bottom; }
  .prosa :global(td) { border-bottom: var(--borde-fino) solid var(--linea); padding: var(--e1) var(--e2); }
  .prosa :global(td:nth-child(n+3)), .prosa :global(th:nth-child(n+3)) { text-align: right; font-variant-numeric: tabular-nums; }
  .prosa :global(hr) { border: 0; border-top: var(--borde-fino) solid var(--linea); margin: var(--e5) 0; }
</style>
