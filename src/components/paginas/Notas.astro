---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { type Idioma, ruta, t } from '../../i18n';

interface Props { idioma: Idioma; }
const { idioma } = Astro.props;
const ui = t(idioma);

// Se listan los escritos de los dos idiomas: uno en inglés no tiene por qué
// desaparecer de la versión en español. Los del otro idioma llevan una marca
// y enlazan a su propia página, sin traducción.
const notas = (await getCollection('notas'))
  .sort((a, b) => b.data.fecha.valueOf() - a.data.fecha.valueOf());

const formato = new Intl.DateTimeFormat(idioma === 'es' ? 'es-GT' : 'en-US', {
  year: 'numeric', month: 'long', day: 'numeric',
  // Las fechas del frontmatter son medianoche UTC: sin esto, en Guatemala
  // (UTC-6) salen un día antes.
  timeZone: 'UTC',
});
---
<Base
  idioma={idioma}
  titulo={`${ui.navNotas} — Ramón Zamora`}
  descripcion={notas.length ? `${notas.length}` : ui.notasVacio}
  alterna={ruta('notas', idioma === 'en' ? 'es' : 'en')}
>
  <section class="banda">
    <div class="envoltura">
      <div class="encabezado-seccion">
        <span class="micro">{ui.navNotas}</span>
        <h1>{ui.navNotas}</h1>
      </div>

      {notas.length === 0
        ? <p class="grande tenue lectura">{ui.notasVacio}</p>
        : (
          <ul class="notas">
            {notas.map((n) => (
              <li class="nota">
                <p class="micro tenue">
                  <time datetime={n.data.fecha.toISOString().slice(0, 10)}>{formato.format(n.data.fecha)}</time>
                  {n.data.idioma !== idioma && <span class="pastilla nota__idioma">{ui.escritoEnOtroIdioma}</span>}
                </p>
                <h2 class="nota__titulo">
                  <a class="limpio" href={`${ruta('notas', n.data.idioma)}${n.id.replace(/^(es|en)\//, '')}/`} hreflang={n.data.idioma} lang={n.data.idioma}>{n.data.titulo}</a>
                </h2>
                {n.data.resumen && <p class="serif tenue" lang={n.data.idioma}>{n.data.resumen}</p>}
              </li>
            ))}
          </ul>
        )}
    </div>
  </section>
</Base>

<style>
  .notas { list-style: none; margin: 0; padding: 0; max-width: var(--ancho-lectura); }
  .nota { padding-bottom: var(--e4); margin-bottom: var(--e4); border-bottom: var(--borde-fino) solid var(--linea); }
  .nota:last-child { border-bottom: 0; }
  .nota__titulo { font-size: var(--h3); margin: var(--e1) 0 var(--e2); }
  .nota__idioma { margin-left: var(--e2); }
</style>
