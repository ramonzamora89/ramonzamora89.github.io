---
import Base from '../layouts/Base.astro';
import { RUTAS, UI } from '../i18n';
---
<Base idioma="en" titulo="404 — Ramón Zamora" descripcion={UI.en.noEncontrado} alterna="/es/">
  <section class="banda">
    <div class="envoltura lectura">
      {(['en', 'es'] as const).map((idioma) => (
        <div class="perdido" lang={idioma}>
          <p class="micro perdido__codigo">404</p>
          <h1 class="serif">{UI[idioma].noEncontrado}</h1>
          <p class="grande tenue">{UI[idioma].noEncontradoTexto}</p>
          <ul class="perdido__enlaces">
            <li><a href={RUTAS.inicio[idioma]}>{UI[idioma].navInicio}</a></li>
            <li><a href={RUTAS.cv[idioma]}>{UI[idioma].navCv}</a></li>
            <li><a href={RUTAS.trabajo[idioma]}>{UI[idioma].navTrabajo}</a></li>
            <li><a href={RUTAS.sobre[idioma]}>{UI[idioma].navSobre}</a></li>
          </ul>
        </div>
      ))}
    </div>
  </section>
</Base>

<style>
  .perdido + .perdido { margin-top: var(--e5); padding-top: var(--e5); border-top: var(--borde-fino) solid var(--linea); }
  .perdido__codigo { color: var(--acento-texto); margin: 0 0 var(--e2); }
  .perdido h1 { font-size: var(--h2); font-weight: 300; }
  .perdido__enlaces { display: flex; flex-wrap: wrap; gap: var(--e3); list-style: none; margin: var(--e3) 0 0; padding: 0; }
</style>
