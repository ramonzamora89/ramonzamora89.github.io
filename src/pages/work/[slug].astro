---
import Pieza from '../../components/paginas/Pieza.astro';
import proyectos from '../../data/proyectos.json';

export function getStaticPaths() {
  return proyectos.map((pieza, i) => ({
    params: { slug: pieza.slug.en },
    props: { pieza, siguiente: proyectos[(i + 1) % proyectos.length] },
  }));
}

const { pieza, siguiente } = Astro.props;
---
<Pieza idioma="en" pieza={pieza} siguiente={siguiente} />
